rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return true; // For this demo, we assume the user is "authenticated" via the UI state
    }
    
    function getUserData() {
      // In this app, we don't use Firebase Auth, so we can't use request.auth.uid.
      // The previous agent built a custom login flow using a 'users' collection.
      // For true security, we'd need Firebase Auth.
      // For now, I'll allow reads to users to find the profile.
      return null;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /wallets/{walletId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
